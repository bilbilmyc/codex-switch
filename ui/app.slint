// Hallmark · pre-emit critique: P5 H5 E5 S5 R5 V4
import { AboutSlint, ListView, ScrollView, Spinner } from "std-widgets.slint";
import { Tokens } from "tokens.slint";

export struct ProfileRow {
    id: string,
    name: string,
    base-url: string,
    model: string,
    is-active: bool,
}

export struct InstructionRow {
    name: string,
    detail: string,
    enabled: bool,
}

export struct UsageModelRow {
    model: string,
    input: string,
    cached: string,
    output: string,
    calls: string,
}

export struct UsageTrendRow {
    date: string,
    input: string,
    cached: string,
    output: string,
    calls: string,
}

component IconButton inherits Rectangle {
    in property <image> icon;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> on-dark: false;
    in property <bool> outlined: false;
    callback clicked;

    width: Tokens.icon-button-size;
    height: Tokens.icon-button-size;
    border-radius: Tokens.radius-md;
    border-width: 1px;
    border-color: !root.outlined ? Tokens.transparent
        : !root.enabled ? Tokens.rule
        : touch.has-hover ? Tokens.ink-secondary
        : Tokens.control-rule;
    background: !root.enabled ? (root.outlined ? Tokens.surface-raised : Tokens.transparent)
        : touch.pressed ? (root.on-dark ? Tokens.sidebar-pressed : Tokens.surface-pressed)
        : touch.has-hover ? (root.on-dark ? Tokens.sidebar-hover : Tokens.surface-hover)
        : root.outlined ? Tokens.surface
        : Tokens.transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    Image {
        source: root.icon;
        width: Tokens.icon-size;
        height: Tokens.icon-size;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        image-fit: contain;
        colorize: !root.enabled ? (root.on-dark ? Tokens.sidebar-disabled : Tokens.rule-strong)
            : root.danger && touch.has-hover ? Tokens.danger
            : root.on-dark ? Tokens.sidebar-ink
            : touch.pressed ? Tokens.ink
            : Tokens.ink-secondary;
    }

    if focus.has-focus && root.enabled: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-md;
        background: Tokens.transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }

    Tooltip { text: @markdown("\{root.accessible-name}"); }
}

// Destructive action with the same neutral and blue visual language as the rest of the app.
// Stable geometry across default, hover, focus, active, and disabled states.
component DangerActionButton inherits Rectangle {
    in property <image> icon;
    in property <string> text;
    in property <string> accessible-name: root.text;
    in property <bool> enabled: true;
    callback clicked;

    width: 78px;
    height: Tokens.control-height;
    border-radius: Tokens.radius-md;
    border-width: 1px;
    border-color: root.enabled ? Tokens.danger : Tokens.rule-strong;
    background: !root.enabled ? Tokens.surface-raised
        : touch.pressed ? Tokens.danger-surface-pressed
        : touch.has-hover ? Tokens.danger-surface-hover
        : Tokens.danger-surface;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.accessible-name;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        spacing: 6px;
        alignment: center;

        Rectangle {
            width: 15px;
            vertical-stretch: 1;
            background: Tokens.transparent;

            Image {
                source: root.icon;
                width: 15px;
                height: 15px;
                y: (parent.height - self.height) / 2;
                image-fit: contain;
                colorize: root.enabled ? Tokens.danger : Tokens.muted;
            }
        }

        Text {
            width: 30px;
            text: root.text;
            color: root.enabled ? Tokens.danger : Tokens.muted;
            font-size: Tokens.text-sm;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    if focus.has-focus && root.enabled: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-sm;
        background: Tokens.transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component QuietButton inherits Rectangle {
    in property <string> text;
    in property <length> button-width: 64px;
    in property <bool> enabled: true;
    in property <bool> danger: false;
    in property <bool> on-dark: false;
    callback clicked;

    width: root.button-width;
    height: Tokens.control-height;
    border-radius: Tokens.radius-md;
    background: !root.enabled ? Tokens.transparent
        : touch.pressed ? (root.on-dark ? Tokens.sidebar-pressed : Tokens.surface-pressed)
        : touch.has-hover ? (root.on-dark ? Tokens.sidebar-hover : Tokens.surface-hover)
        : Tokens.transparent;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    Text {
        text: root.text;
        color: !root.enabled ? (root.on-dark ? Tokens.sidebar-disabled : Tokens.rule-strong)
            : root.danger ? Tokens.danger
            : root.on-dark ? Tokens.sidebar-ink
            : Tokens.ink-secondary;
        font-size: Tokens.text-sm;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if focus.has-focus && root.enabled: Rectangle {
        x: 1px;
        y: 1px;
        width: parent.width - 2px;
        height: parent.height - 2px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-md;
        background: Tokens.transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component CommandButton inherits Rectangle {
    in property <string> text;
    in property <length> button-width: 92px;
    in property <bool> enabled: true;
    in property <bool> primary: false;
    in property <bool> danger: false;
    callback clicked;

    width: root.button-width;
    height: Tokens.control-height;
    border-radius: Tokens.radius-md;
    border-width: 1px;
    border-color: !root.enabled ? Tokens.rule
        : root.primary ? (root.danger ? Tokens.danger : Tokens.accent)
        : root.danger ? Tokens.danger
        : Tokens.rule-strong;
    background: !root.enabled ? Tokens.surface-raised
        : root.primary && root.danger ? (touch.pressed ? Tokens.danger-hover : Tokens.danger)
        : root.primary ? (touch.pressed ? Tokens.accent-hover : Tokens.accent)
        : touch.pressed ? Tokens.surface-pressed
        : touch.has-hover ? Tokens.surface-hover
        : Tokens.surface;
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-action-default => {
        if root.enabled { root.clicked(); }
    }

    Text {
        text: root.text;
        color: !root.enabled ? Tokens.muted
            : root.primary ? Tokens.accent-ink
            : root.danger ? Tokens.danger
            : Tokens.ink;
        font-size: Tokens.text-sm;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if focus.has-focus && root.enabled: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 2px;
        border-color: root.primary ? Tokens.accent : Tokens.focus;
        border-radius: Tokens.radius-sm;
        background: Tokens.transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { root.clicked(); }
    }

    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

component TextField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <InputType> input-type: InputType.text;
    in property <bool> enabled: true;
    callback edited(string);

    height: Tokens.control-height;
    background: Tokens.field;
    border-width: 1px;
    border-color: input.has-focus ? Tokens.ink-secondary : Tokens.control-rule;
    border-radius: Tokens.radius-md;
    opacity: root.enabled ? 1 : 0.55;
    forward-focus: input;

    if root.text == "" && !input.has-focus: Text {
        x: Tokens.space-xs;
        width: parent.width - Tokens.space-md;
        height: parent.height;
        text: root.placeholder-text;
        color: Tokens.muted;
        font-size: Tokens.text-base;
        font-weight: 400;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: Tokens.space-xs;
        width: parent.width - Tokens.space-md;
        height: parent.height;
        text <=> root.text;
        input-type: root.input-type;
        enabled: root.enabled;
        single-line: true;
        font-size: Tokens.text-base;
        font-weight: 400;
        color: Tokens.ink;
        selection-background-color: Tokens.accent;
        selection-foreground-color: Tokens.accent-ink;
        vertical-alignment: center;
        edited => { root.edited(self.text); }
    }

    if input.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-sm;
        background: Tokens.transparent;
    }
}

component UnitNumberField inherits Rectangle {
    in-out property <string> text;
    in property <string> placeholder-text;
    in property <string> unit;
    in property <string> accessible-name;
    in property <bool> enabled: true;
    callback edited(string);

    width: Tokens.context-control-width;
    height: Tokens.control-height;
    background: Tokens.surface;
    border-width: 1px;
    border-color: input.has-focus ? Tokens.ink-secondary : Tokens.control-rule;
    border-radius: Tokens.radius-md;
    opacity: root.enabled ? 1 : 0.55;
    forward-focus: input;

    if root.text == "" && !input.has-focus: Text {
        x: Tokens.space-xs;
        width: parent.width - 52px;
        height: parent.height;
        text: root.placeholder-text;
        color: Tokens.muted;
        font-size: Tokens.text-base;
        font-weight: 400;
        horizontal-alignment: right;
        vertical-alignment: center;
        overflow: elide;
    }

    input := TextInput {
        x: Tokens.space-xs;
        width: parent.width - 52px;
        height: parent.height;
        text <=> root.text;
        input-type: InputType.text;
        enabled: root.enabled;
        single-line: true;
        font-size: Tokens.text-base;
        font-weight: 700;
        color: Tokens.ink;
        selection-background-color: Tokens.accent;
        selection-foreground-color: Tokens.accent-ink;
        horizontal-alignment: right;
        vertical-alignment: center;
        accessible-label: root.accessible-name;
        edited => { root.edited(self.text); }
    }

    Text {
        x: parent.width - 36px;
        width: 24px;
        height: parent.height;
        text: root.unit;
        color: Tokens.muted;
        font-size: Tokens.text-sm;
        font-weight: 600;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    if input.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-sm;
        background: Tokens.transparent;
    }
}

component ToggleRow inherits Rectangle {
    in-out property <bool> checked;
    in property <string> text;
    in property <bool> enabled: true;
    callback toggled;

    height: Tokens.control-height;
    opacity: root.enabled ? 1 : 0.55;
    border-radius: Tokens.radius-md;
    background: !root.enabled ? Tokens.transparent
        : touch.pressed ? Tokens.surface-pressed
        : touch.has-hover ? Tokens.surface-hover
        : Tokens.transparent;
    forward-focus: focus;
    accessible-role: checkbox;
    accessible-label: root.text;
    accessible-enabled: root.enabled;
    accessible-checkable: true;
    accessible-checked: root.checked;
    accessible-action-default => {
        if root.enabled {
            root.checked = !root.checked;
            root.toggled();
        }
    }

    HorizontalLayout {
        spacing: Tokens.space-xs;

        Rectangle {
            width: 16px;
            vertical-stretch: 1;
            background: Tokens.transparent;

            box := Rectangle {
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                border-radius: Tokens.radius-sm;
                border-width: 1px;
                border-color: root.checked ? Tokens.accent : Tokens.rule-strong;
                background: root.checked ? Tokens.accent : Tokens.field;

                if root.checked: Image {
                    x: 2px;
                    y: 2px;
                    width: 12px;
                    height: 12px;
                    source: @image-url("../assets/icons/check.svg");
                    colorize: Tokens.accent-ink;
                    image-fit: contain;
                }
            }
        }
        Text {
            text: root.text;
            color: Tokens.ink-secondary;
            font-size: Tokens.text-sm;
            font-weight: 500;
            vertical-alignment: center;
            horizontal-stretch: 1;
        }
    }

    if focus.has-focus && root.enabled: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-sm;
        background: Tokens.transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => {
            root.checked = !root.checked;
            root.toggled();
        }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.checked = !root.checked;
                root.toggled();
                return accept;
            }
            return reject;
        }
    }
}

component ModelSelect inherits Rectangle {
    in property <[string]> model;
    in-out property <int> current-index: -1;
    in property <bool> enabled: true;
    callback selected(string);
    property <string> current-text: root.current-index >= 0 && root.current-index < root.model.length
        ? root.model[root.current-index] : "选择模型";

    height: Tokens.control-height;
    background: Tokens.field;
    border-width: 1px;
    border-color: focus.has-focus ? Tokens.ink-secondary : Tokens.control-rule;
    border-radius: Tokens.radius-md;
    opacity: root.enabled ? 1 : 0.55;
    forward-focus: focus;
    accessible-role: combobox;
    accessible-label: "模型";
    accessible-value: root.current-text;
    accessible-enabled: root.enabled;
    accessible-expandable: true;
    accessible-action-expand => { popup.show(); }

    HorizontalLayout {
        padding-left: Tokens.space-xs;
        padding-right: Tokens.space-xs;
        spacing: Tokens.space-xs;

        Text {
            text: root.current-text;
            color: root.current-index >= 0 ? Tokens.ink : Tokens.muted;
            font-size: Tokens.text-base;
            font-weight: 400;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
        Rectangle {
            width: 24px;
            vertical-stretch: 1;
            background: Tokens.transparent;

            Image {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 16px;
                height: 16px;
                source: @image-url("../assets/icons/chevron-down.svg");
                colorize: Tokens.ink-secondary;
                image-fit: contain;
            }
        }
    }

    if focus.has-focus && root.enabled: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 4px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-sm;
        background: Tokens.transparent;
    }

    touch := TouchArea {
        enabled: root.enabled;
        clicked => { popup.show(); }
    }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        enabled: root.enabled;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                popup.show();
                return accept;
            }
            return reject;
        }
    }

    popup := PopupWindow {
        x: 0px;
        width: root.width;
        height: min(root.model.length, 6) * 32px + Tokens.space-xs;
        y: -self.height - Tokens.space-2xs;
        close-policy: close-on-click-outside;

        Rectangle {
            background: Tokens.surface;
            border-width: 1px;
            border-color: Tokens.rule-strong;
            border-radius: Tokens.radius-md;

            ListView {
                x: Tokens.space-2xs;
                y: Tokens.space-2xs;
                width: parent.width - Tokens.space-xs;
                height: parent.height - Tokens.space-xs;

                for option[index] in root.model: Rectangle {
                    height: 32px;
                    border-radius: Tokens.radius-sm;
                    background: root.current-index == index ? Tokens.selected-surface
                        : option-touch.has-hover ? Tokens.surface-hover
                        : Tokens.transparent;

                    Text {
                        x: Tokens.space-xs;
                        width: parent.width - Tokens.space-md;
                        text: option;
                        color: Tokens.ink;
                        font-size: Tokens.text-base;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                    option-touch := TouchArea {
                        clicked => {
                            root.current-index = index;
                            root.selected(option);
                            popup.close();
                        }
                    }
                }
            }
        }
    }
}

component FieldLabel inherits Text {
    in property <string> label;
    text: root.label;
    height: 16px;
    color: Tokens.ink-secondary;
    font-size: Tokens.text-sm;
    font-weight: 500;
    horizontal-alignment: left;
    vertical-alignment: center;
}

component SectionLabel inherits Text {
    in property <string> label;
    text: root.label;
    height: 20px;
    color: Tokens.ink;
    font-size: Tokens.text-base;
    font-weight: 600;
    horizontal-alignment: left;
    vertical-alignment: center;
}

component SummaryRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 40px;
    border-width: 0px;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: parent.width;
        background: Tokens.rule;
    }
    HorizontalLayout {
        spacing: Tokens.space-md;
        Text {
            width: 108px;
            text: root.label;
            color: Tokens.ink-secondary;
            font-size: Tokens.text-sm;
            font-weight: 500;
            horizontal-alignment: left;
            vertical-alignment: center;
        }
        Text {
            text: root.value;
            color: Tokens.ink;
            font-size: Tokens.text-base;
            font-weight: 600;
            horizontal-alignment: left;
            vertical-alignment: center;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }
}

component StatusDot inherits Rectangle {
    in property <color> dot-color;
    width: 8px;
    vertical-stretch: 1;
    background: Tokens.transparent;
    Rectangle {
        y: (parent.height - self.height) / 2;
        width: 7px;
        height: 7px;
        border-radius: 4px;
        background: root.dot-color;
    }
}

component NavTab inherits Rectangle {
    in property <string> text;
    in property <bool> selected;
    callback clicked;

    width: 66px;
    height: 40px;
    background: touch.pressed ? Tokens.surface-pressed
        : touch.has-hover ? Tokens.surface-hover
        : Tokens.transparent;
    forward-focus: focus;
    accessible-role: tab;
    accessible-label: root.text;
    accessible-action-default => { root.clicked(); }

    Text {
        text: root.text;
        color: root.selected ? Tokens.ink : Tokens.muted;
        font-size: Tokens.text-base;
        font-weight: root.selected ? 600 : 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    if root.selected: Rectangle {
        x: 9px;
        y: parent.height - 3px;
        width: parent.width - 18px;
        height: 3px;
        border-radius: 2px;
        background: Tokens.accent;
    }
    if focus.has-focus: Rectangle {
        x: 2px;
        y: 2px;
        width: parent.width - 4px;
        height: parent.height - 5px;
        border-width: 2px;
        border-color: Tokens.focus;
        border-radius: Tokens.radius-sm;
        background: Tokens.transparent;
    }
    touch := TouchArea { clicked => { root.clicked(); } }
    focus := FocusScope {
        x: 0px;
        width: 0px;
        key-pressed(event) => {
            if event.text == " " || event.text == "\n" {
                root.clicked();
                return accept;
            }
            return reject;
        }
    }
}

